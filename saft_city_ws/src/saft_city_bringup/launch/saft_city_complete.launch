<?xml version="1.0"?>
<launch>
  <arg name="model" default="waffle_pi"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="slam" default="true"/>
  <arg name="gui" default="true"/>

  <param name="use_sim_time" value="$(arg use_sim_time)"/>
  <env name="TURTLEBOT3_MODEL" value="$(arg model)"/>

  <!-- 1. Gazebo 环形跑道 -->
  <include file="$(find saft_city_gazebo)/launch/saft_city_world.launch">
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <!-- 2. 生成 TurtleBot3 -->
  <include file="$(find saft_city_gazebo)/launch/spawn_robot.launch">
    <arg name="model" value="$(arg model)"/>
    <arg name="x" value="0.0"/>
    <arg name="y" value="0.0"/>
    <arg name="yaw" value="0.0"/>
  </include>

  <!-- 3. 导航 -->
  <include file="$(find saft_city_navigation)/launch/navigation.launch">
    <arg name="mode" value="$(eval 'slam' if arg('slam') else 'localization')"/>
  </include>

  <!-- 4. Rviz -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find saft_city_description)/config/navigation.rviz" required="true"/>
</launch>
