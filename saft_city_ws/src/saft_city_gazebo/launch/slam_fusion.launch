<?xml version="1.0"?>
<launch>
  <!-- RGB-D + LiDAR 融合 SLAM（RTAB-Map）-->

  <!-- RGB-D 视觉里程计 -->
  <node name="rtabmap_odom" pkg="rtabmap_odom" type="rgbd_odometry">
    <param name="frame_id" value="base_link"/>
    <param name="odom_frame_id" value="odom"/>
    <remap from="rgb/image"       to="/realsense/color/image_raw"/>
    <remap from="depth/image"     to="/realsense/depth/image_rect_raw"/>
    <remap from="rgb/camera_info" to="/realsense/color/camera_info"/>
  </node>

  <!-- 激光+视觉融合 SLAM -->
  <node name="rtabmap_slam" pkg="rtabmap_slam" type="rtabmap" output="screen">
    <param name="frame_id" value="base_link"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="map_frame_id"  value="map"/>
    <param name="subscribe_scan" value="true"/>
    <param name="subscribe_odom" value="true"/>

    <remap from="scan"       to="/front/scan"/>
    <remap from="odom"       to="/rtabmap/odom"/>
    <remap from="rgb/image"       to="/realsense/color/image_raw"/>
    <remap from="depth/image"     to="/realsense/depth/image_rect_raw"/>
    <remap from="rgb/camera_info" to="/realsense/color/camera_info"/>

    <!-- 地图参数 -->
    <param name="map_2d" value="true"/>
    <param name="grid_2d" value="true"/>
    <param name="grid_depth" value="true"/>
    <param name="grid_range_min" value="0.1"/>
    <param name="grid_range_max" value="8.0"/>
  </node>
</launch>
