<?xml version="1.0"?>
<launch>
  <!-- 建图启动器：Gazebo + Husky + SLAM + Rviz -->

  <!-- Husky 传感器配置 -->
  <env name="HUSKY_SENSOR_ARCH" value="1"/>
  <env name="HUSKY_REALSENSE_ENABLED" value="1"/>
  <env name="HUSKY_LMS1XX_ENABLED" value="1"/>
  <env name="HUSKY_REALSENSE_XYZ" value="0.12 0 0.28"/>
  <env name="HUSKY_REALSENSE_RPY" value="0 0.15 0"/>

  <!-- 1. Gazebo + 围墙赛道 + Husky（官方 spawn 方式） -->
  <include file="$(find saft_city_gazebo)/launch/saft_city_world.launch">
    <arg name="x" value="0.7"/>
    <arg name="y" value="-7.0"/>
  </include>

  <!-- 等待机器人就绪 + 加载控制器 + 启动 robot_state_publisher -->
  <node name="init_controllers" pkg="saft_city_gazebo" type="scripts/wait_and_init.py" output="screen"/>
  <node name="rsp_auto" pkg="robot_state_publisher" type="robot_state_publisher" required="false"/>

  <!-- 2. SLAM（重定向 scan→front/scan 确保收到激光） -->
  <include file="$(find saft_city_navigation)/launch/gmapping_slam.launch">
    <arg name="scan_topic" value="/front/scan"/>
  </include>

  <!-- 3. Rviz -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find saft_city_description)/config/navigation.rviz" required="false"/>
</launch>
