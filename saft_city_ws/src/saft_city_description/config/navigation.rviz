        rear_right_wheel_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        sensor_arch_base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
        sensor_arch_mount_link:
          Alpha: 1
